<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/competencygrid/db" VERSION="20261110" COMMENT="XMLDB file for Moodle local/competencygrid"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_competencygrid" COMMENT="Competency grids">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Display name of the grid"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Plain text description"/>
        <FIELD NAME="subject" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Subject, e.g. Betriebswirtschaftslehre"/>
        <FIELD NAME="classlevel" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Class or year, e.g. Jahrgang 11"/>
        <FIELD NAME="edulevel" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Educational level, e.g. Sekundarstufe II"/>
        <FIELD NAME="schooltype" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="School type or qualification"/>
        <FIELD NAME="sentencestart" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Common sentence start shown as a hint"/>
        <FIELD NAME="license" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Moodle license shortname"/>
        <FIELD NAME="visibility" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = private, 1 = site"/>
        <FIELD NAME="source" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Stable exacomp source identifier"/>
        <FIELD NAME="edulevelsourceid" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Imported exacomp edulevel id"/>
        <FIELD NAME="schooltypesourceid" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Imported exacomp schooltype id"/>
        <FIELD NAME="subjectsourceid" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Imported exacomp subject id"/>
        <FIELD NAME="ownerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="ownerid" TYPE="foreign" FIELDS="ownerid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_competencygrid_level" COMMENT="Levels (columns) of a competency grid">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="gridid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Short hint, e.g. typical operators"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="sourceid" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Imported exacomp niveau id"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="gridid" TYPE="foreign" FIELDS="gridid" REFTABLE="local_competencygrid" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_competencygrid_topic" COMMENT="Topics (rows) of a competency grid">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="gridid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="sourceid" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Imported exacomp topic id"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="gridid" TYPE="foreign" FIELDS="gridid" REFTABLE="local_competencygrid" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_competencygrid_comp" COMMENT="Competencies (cells) of a competency grid">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="gridid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="topicid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="levelid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="sourceid" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Imported exacomp descriptor id"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="gridid" TYPE="foreign" FIELDS="gridid" REFTABLE="local_competencygrid" REFFIELDS="id"/>
        <KEY NAME="topicid" TYPE="foreign" FIELDS="topicid" REFTABLE="local_competencygrid_topic" REFFIELDS="id"/>
        <KEY NAME="levelid" TYPE="foreign" FIELDS="levelid" REFTABLE="local_competencygrid_level" REFFIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_competencygrid_member" COMMENT="Collaborators of a competency grid">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="gridid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="role" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="viewer" SEQUENCE="false" COMMENT="editor or viewer"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="gridid" TYPE="foreign" FIELDS="gridid" REFTABLE="local_competencygrid" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="griduser" UNIQUE="true" FIELDS="gridid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
