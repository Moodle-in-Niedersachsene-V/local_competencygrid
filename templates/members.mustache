{{!
    @template local_competencygrid/members

    List of collaborators on the share page.

    Example context (json):
    {
        "owner": "F. Küppers",
        "hasmembers": true,
        "members": [{"id": 3, "name": "M. Schulz", "role": "Editor", "removeurl": "#"}],
        "sesskey": "abc"
    }
}}
<div class="local-competencygrid local-competencygrid-members mb-4">
    <table class="table generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} name {{/str}}</th>
                <th scope="col">{{#str}} role, local_competencygrid {{/str}}</th>
                <th scope="col"><span class="visually-hidden sr-only">{{#str}} actions {{/str}}</span></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{owner}}</td>
                <td>{{#str}} roleowner, local_competencygrid {{/str}}</td>
                <td></td>
            </tr>
            {{#members}}
            <tr>
                <td>{{name}}</td>
                <td>{{role}}</td>
                <td class="text-end text-right">
                    <form method="post" action="{{removeurl}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">{{#str}} remove {{/str}}</button>
                    </form>
                </td>
            </tr>
            {{/members}}
        </tbody>
    </table>
</div>
