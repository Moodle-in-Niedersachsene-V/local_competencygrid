{{!
    @template local_competencygrid/name_form

    Modal body for a topic or level name.

    Example context (json):
    {
        "name": "Marketing",
        "hasdescription": true,
        "description": "nennen, beschreiben"
    }
}}
<form data-region="name-form" novalidate>
    <div class="mb-3">
        <label class="form-label" for="local-competencygrid-name">{{#str}} name {{/str}}</label>
        <input type="text" class="form-control" id="local-competencygrid-name" name="name" value="{{name}}" maxlength="255" required>
    </div>
    {{#hasdescription}}
    <div class="mb-3">
        <label class="form-label" for="local-competencygrid-description">{{#str}} leveldescription, local_competencygrid {{/str}}</label>
        <input type="text" class="form-control" id="local-competencygrid-description" name="description" value="{{description}}" maxlength="255">
    </div>
    {{/hasdescription}}
</form>
