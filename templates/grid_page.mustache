{{!
    @template local_competencygrid/grid_page

    Page around the grid editor.

    Example context (json):
    {
        "gridid": 1,
        "chips": [{"text": "Sekundarstufe II"}],
        "description": "",
        "canmanage": true,
        "settingsurl": "#",
        "shareurl": "#",
        "deleteurl": "#",
        "exportexacompurl": "#",
        "exportcsvurl": "#"
    }
}}
<div class="local-competencygrid local-competencygrid-page">
    <div class="d-flex flex-wrap align-items-start gap-3 mb-3">
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap gap-2">
                {{#chips}}<span class="local-competencygrid-chip">{{text}}</span>{{/chips}}
            </div>
            {{#description}}<p class="mt-2 mb-0">{{description}}</p>{{/description}}
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="{{exportexacompurl}}">{{#str}} exportexacomp, local_competencygrid {{/str}}</a>
            <a class="btn btn-outline-secondary" href="{{exportcsvurl}}">{{#str}} exportmoodlecsv, local_competencygrid {{/str}}</a>
            {{#canmanage}}
            <a class="btn btn-outline-secondary" href="{{settingsurl}}">{{#str}} settings {{/str}}</a>
            <a class="btn btn-primary" href="{{shareurl}}">{{#str}} share, local_competencygrid {{/str}}</a>
            <a class="btn btn-outline-danger" href="{{deleteurl}}">{{#str}} delete {{/str}}</a>
            {{/canmanage}}
        </div>
    </div>
    <div class="local-competencygrid-editor" data-region="local_competencygrid-editor" data-gridid="{{gridid}}">
        <section class="local-competencygrid-main card" aria-label="{{#str}} grid, local_competencygrid {{/str}}">
            <div data-region="grid">
                <div class="p-4">{{> core/loading }}</div>
            </div>
        </section>
        <aside class="local-competencygrid-panel card" data-region="panel" aria-live="polite"></aside>
    </div>
</div>
